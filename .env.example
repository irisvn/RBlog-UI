# RBlog APP_URL, no trailing slash
RBLOG_URL=http://localhost:8000
# Content API key (admin → Integrations → Content API). Server-side only: never NEXT_PUBLIC_.
RBLOG_CONTENT_KEY=rcms_…
# Same secret as RBlog Settings → Integrations → Webhook
RBLOG_WEBHOOK_SECRET=
# Public URL of this site (canonical, sitemap, RSS). Falls back to RBlog's frontend_url setting.
SITE_URL=http://localhost:3000
